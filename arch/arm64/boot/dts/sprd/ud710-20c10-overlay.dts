/dts-v1/;
/plugin/;

#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	fragment {
		target-path = "/";
		__overlay__ {

			gpio-keys {
				compatible = "gpio-keys";

				key-volumedown {
					label = "Volume Down Key";
					linux,code = <KEY_VOLUMEDOWN>;
					gpios = <&eic_debounce 18 GPIO_ACTIVE_LOW>;
					debounce-interval = <2>;
					wakeup-source;
				};

				key-volumeup {
					label = "Volume Up Key";
					linux,code = <KEY_VOLUMEUP>;
					gpios = <&pmic_eic 4 GPIO_ACTIVE_HIGH>;
					debounce-interval = <2>;
					wakeup-source;
				};

				key-power {
					label = "Power Key";
					linux,code = <KEY_POWER>;
					gpios = <&pmic_eic 1 GPIO_ACTIVE_LOW>;
					debounce-interval = <2>;
					wakeup-source;
				};

				key-ai {
					label = "AI Key";
					linux,code = <766>;
					gpios = <&eic_debounce 19 GPIO_ACTIVE_LOW>;
					debounce-interval = <2>;
					wakeup-source;
				};
			};

			fingerprint@0 {
				compatible = "microarray,afs121";
				fpint-gpios = <&eic_async 29 0>;
			};
		};
	};
};

&i2c3 {
	status = "okay";

	synaptics-touch@20 {
		compatible = "synaptics,dsx";
		reg = <0x20>;
		gpios = <&ap_gpio 145 GPIO_ACTIVE_HIGH
			&ap_gpio 144 GPIO_ACTIVE_HIGH>;
	};

	ktd3137_backlight: backlight@36 {
		status = "okay";
		compatible = "sprd,ktd3137";
		reg = <0x36>;
		hwen-gpio = <&ap_gpio 133 GPIO_ACTIVE_HIGH>;
		ktd,using-lsb;
		ktd,using-linear;
		ktd,bl-fscal-led = <0x99>;/*default 20.2mA*/
		ktd,turn-on-ramp = <0>; /* Should add ms value, please check datasheet*/
		ktd,turn-off-ramp = <0>;  /* Should add ms value, please check datasheet*/
		ktd,i2c-trans-dim = <0>;  /* Should add ms value, please check datasheet*/
		ktd,bl-channel = <2>;
		ktd,ovp-level = <32>; /*default 32v*/
		ktd,inductor-current = <1800>; /*dfault 2600mA*/
		ktd,switching-frequency = <1000>;/*dfault 1000KHz*/
	};
};

&panel {
	sprd,backlight = <&ktd3137_backlight>;
};

&ddr_dfs {
	sprd-scene = "boost", "lcdon", "lcdoff", "camlow",
		"camhigh", "camveryhigh";
	sprd-freq = <1333 768 256 384 667 1333>;
};
