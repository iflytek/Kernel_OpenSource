#
# elan Touchscreen driver
#

config TOUCHSCREEN_ELAN
	bool "Elan touchpanel driver"
	help
	  This is the main file for touchpanel driver for Elan
	  touchscreens.

	  Say Y here if you have a Elan touchscreen connected
	  to your system.

	  If unsure, say N.

	  To compile this driver as a module, choose M here: the
	  module will be called elan.
