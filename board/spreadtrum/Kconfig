source "board/spreadtrum/iwhale2/Kconfig"
source "board/spreadtrum/iwhale2_vp/Kconfig"
source "board/spreadtrum/sp9830a-5h10_ga1/Kconfig"
source "board/spreadtrum/sp9830a-7h10_ga1/Kconfig"

